# Weekly HMM trainer — runs Baum-Welch EM to completion and exits.
# Build context is the repo root (training/ imports `momentarily` from src/),
# so build with: docker build -f training/Containerfile .
# python:3.13-slim (multi-arch index digest, pinned for reproducible builds).
FROM python@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285

# uv for deterministic, frozen-lockfile installs (ghcr.io/astral-sh/uv:0.5).
COPY --from=ghcr.io/astral-sh/uv@sha256:7bff3c3776ec467fc1437960f2c469d8beb30f536a6465a3350c647ccd260ec2 /uv /uvx /bin/

WORKDIR /app

# Dependency layer first for cache reuse. README/LICENSE are referenced by
# pyproject metadata, so the local package build needs them present.
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src/ ./src/
RUN uv sync --frozen --no-dev

# Training code changes more often than deps — copy it last.
COPY training/ ./training/

# Code provenance: the deploy script writes .build-sha (git HEAD) into the build
# context — the image excludes .git, so this file is how the container learns
# which commit it was built from. The [a] glob makes the copy optional, so a
# bare `docker build .` without the file still succeeds (code_sha then falls
# back to "unknown"). See training/provenance.py.
COPY .build-sh[a] ./
ENV MOMENTARILY_PRODUCER=container

ENV PATH="/app/.venv/bin:$PATH"

# Drop privileges after all root-owned build steps. Hand the app tree — the
# uv-built .venv included — to an unprivileged user, and point uv's cache at
# that user's home so any runtime `uv` (the Worker may override the entrypoint)
# has a writable, user-owned cache instead of falling back to root's.
RUN useradd --create-home --uid 10001 trainer \
    && chown -R trainer:trainer /app
ENV UV_CACHE_DIR=/home/trainer/.cache/uv
USER trainer

# Batch default for local `docker run`; the Worker overrides entrypoint + env
# at start(). Credentials come from R2_* env vars (see training/r2_client.py).
CMD ["python", "-m", "training.train_em"]

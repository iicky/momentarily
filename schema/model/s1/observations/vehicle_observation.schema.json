{
  "$defs": {
    "LegacyLineage": {
      "additionalProperties": false,
      "description": "Read from a legacy archive object. What it lacks is ``Unknown`` on the\nrecord; layer 3 labels anything it derives from it as legacy-derived.",
      "properties": {
        "archive": {
          "enum": [
            "archive/trace",
            "archive/trip_updates",
            "archive/vehicles",
            "archive/alerts",
            "archive/alerts_liveness",
            "archive/ene",
            "archive/health",
            "v1/predictions"
          ],
          "title": "Archive",
          "type": "string"
        },
        "kind": {
          "const": "legacy",
          "title": "Kind",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/LegacyPeriod"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Position of the row in that object; null when it holds one.",
          "title": "Row Index"
        },
        "source_key": {
          "description": "The legacy object the record came from.",
          "title": "Source Key",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "archive",
        "source_key",
        "row_index",
        "period"
      ],
      "title": "LegacyLineage",
      "type": "object"
    },
    "LegacyPeriod": {
      "additionalProperties": false,
      "description": "The UTC days ``[start, end)`` for which a legacy archive stands in for\nthe recorder's records.",
      "properties": {
        "end": {
          "anyOf": [
            {
              "description": "ISO date of a UTC calendar day (never a service day).",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exclusive: the first UTC day the recorder wrote the replacing record; null while it has not.",
          "title": "End"
        },
        "start": {
          "description": "First UTC day the legacy archive covers.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "LegacyPeriod",
      "type": "object"
    },
    "RawLineage": {
      "additionalProperties": false,
      "description": "Decoded from a stored raw payload.",
      "properties": {
        "kind": {
          "const": "raw",
          "title": "Kind",
          "type": "string"
        },
        "payload_key": {
          "description": "The tick bundle or blob holding the bytes.",
          "title": "Payload Key",
          "type": "string"
        },
        "payload_member": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Bundle member; null for a blob.",
          "title": "Payload Member"
        },
        "payload_sha256": {
          "description": "Lowercase sha256 hex.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "payload_key",
        "payload_member",
        "payload_sha256"
      ],
      "title": "RawLineage",
      "type": "object"
    },
    "TripDescriptorObs": {
      "additionalProperties": false,
      "description": "A GTFS-RT TripDescriptor with the NYCT extension, as published.\n``Unknown`` only on legacy rows (the trace kept trip_id alone).",
      "properties": {
        "direction_id": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "$ref": "#/$defs/Unknown"
            },
            {
              "type": "null"
            }
          ],
          "title": "Direction Id"
        },
        "nyct_direction": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3,
                4
              ],
              "type": "integer"
            },
            {
              "$ref": "#/$defs/Unknown"
            },
            {
              "type": "null"
            }
          ],
          "title": "Nyct Direction"
        },
        "nyct_is_assigned": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/Unknown"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when the extension omits it; never read as false.",
          "title": "Nyct Is Assigned"
        },
        "nyct_train_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Unknown"
            },
            {
              "type": "null"
            }
          ],
          "title": "Nyct Train Id"
        },
        "route_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Unknown"
            },
            {
              "type": "null"
            }
          ],
          "description": "As published: '6X', 'SS', never folded.",
          "title": "Route Id"
        },
        "schedule_relationship": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "#/$defs/Unknown"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule Relationship"
        },
        "start_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Unknown"
            },
            {
              "type": "null"
            }
          ],
          "description": "Published 'YYYYMMDD'; not a ServiceDate.",
          "title": "Start Date"
        },
        "start_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Unknown"
            },
            {
              "type": "null"
            }
          ],
          "description": "Published 'HH:MM:SS'; may exceed 24h.",
          "title": "Start Time"
        },
        "trip_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Trip Id"
        }
      },
      "required": [
        "trip_id",
        "route_id",
        "start_time",
        "start_date",
        "schedule_relationship",
        "direction_id",
        "nyct_train_id",
        "nyct_is_assigned",
        "nyct_direction"
      ],
      "title": "TripDescriptorObs",
      "type": "object"
    },
    "Unknown": {
      "additionalProperties": false,
      "description": "A measurement that was expected but could not be taken, and why.",
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "unknown": {
          "const": true,
          "title": "Unknown",
          "type": "boolean"
        }
      },
      "required": [
        "unknown",
        "reason"
      ],
      "title": "Unknown",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One VehiclePosition entity. A placeholder for an undispatched trip is\nrecorded as published: no status, future timestamp. Legacy rows come\nfrom ``archive/trace``.",
  "properties": {
    "congestion_level": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "$ref": "#/$defs/Unknown"
        },
        {
          "type": "null"
        }
      ],
      "title": "Congestion Level"
    },
    "current_status": {
      "anyOf": [
        {
          "enum": [
            0,
            1,
            2
          ],
          "type": "integer"
        },
        {
          "$ref": "#/$defs/Unknown"
        },
        {
          "type": "null"
        }
      ],
      "description": "0 INCOMING_AT, 1 STOPPED_AT, 2 IN_TRANSIT_TO; null when omitted.",
      "title": "Current Status"
    },
    "current_stop_sequence": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "$ref": "#/$defs/Unknown"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Stop Sequence"
    },
    "entity_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Unknown"
        }
      ],
      "title": "Entity Id"
    },
    "entity_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "$ref": "#/$defs/Unknown"
        }
      ],
      "description": "Position of the entity in the feed.",
      "title": "Entity Index"
    },
    "fetch_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Unknown"
        }
      ],
      "description": "The FeedFetch decoded; Unknown on legacy rows.",
      "title": "Fetch Id"
    },
    "lineage": {
      "discriminator": {
        "mapping": {
          "legacy": "#/$defs/LegacyLineage",
          "raw": "#/$defs/RawLineage"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RawLineage"
        },
        {
          "$ref": "#/$defs/LegacyLineage"
        }
      ],
      "title": "Lineage"
    },
    "observed_at": {
      "description": "UTC epoch seconds.",
      "minimum": 0,
      "title": "Observed At",
      "type": "integer"
    },
    "source": {
      "anyOf": [
        {
          "enum": [
            "ace",
            "bdfm",
            "g",
            "jz",
            "nqrw",
            "l",
            "numbered",
            "si"
          ],
          "type": "string"
        },
        {
          "$ref": "#/$defs/Unknown"
        }
      ],
      "title": "Source"
    },
    "stop_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "As published, realtime-only ids kept.",
      "title": "Stop Id"
    },
    "trip": {
      "anyOf": [
        {
          "$ref": "#/$defs/TripDescriptorObs"
        },
        {
          "type": "null"
        }
      ],
      "description": "null when the vehicle has no trip."
    },
    "unmodeled_fields": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "$ref": "#/$defs/Unknown"
        }
      ],
      "description": "Field paths present but not decoded, e.g. '2' (position).",
      "title": "Unmodeled Fields"
    },
    "vehicle_timestamp": {
      "anyOf": [
        {
          "description": "UTC epoch seconds.",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "Verbatim; may be in the future.",
      "title": "Vehicle Timestamp"
    }
  },
  "required": [
    "lineage",
    "fetch_id",
    "source",
    "observed_at",
    "entity_index",
    "entity_id",
    "trip",
    "stop_id",
    "current_stop_sequence",
    "current_status",
    "vehicle_timestamp",
    "congestion_level",
    "unmodeled_fields"
  ],
  "title": "VehicleObservation",
  "type": "object"
}

# The collector needs no secrets. Every feed it polls
# (camsys/subway-alerts.json, nyct/nyct_ene.json, nyct/nyct_ene_upcoming.json)
# is served publicly from the MTA developer gateway at api-endpoint.mta.info
# without authentication — no MTA API key required. The gateway's protobuf
# trip-update and vehicle-position feeds are keyless too (verified HTTP 200
# without a key), so no key is needed even when those are added.

# Optional overrides — defaults are sensible
# POLL_INTERVAL_SECONDS=300       # subway alerts: every 5 minutes
# ENE_POLL_INTERVAL_SECONDS=3600  # E&E: every hour
# LOG_LEVEL=INFO

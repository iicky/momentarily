#!/usr/bin/env bash
# Project pre-commit gate. Runs, in order:
#   1. Adversarial review of the staged diff (.githooks/review.sh) — blocks on
#      a real VERDICT: FAIL, fails OPEN on any infra problem (see that file's
#      header for the exact contract).
#   2. A staged-reference guard that rejects commits leaking references to
#      this repo's local, private issue tracker (its shorthand IDs, its CLI
#      invocations, or its name used in prose) into tracked files.
#   3. Lint + typecheck, scoped to the subtrees that have staged changes,
#      mirroring CI (.github/workflows/ci.yml) plus viz. Auto-fixes
#      formatting/lint and re-stages the result.
#
# Gates 1 and 2 run unconditionally, ahead of the PRECOMMIT_SKIP check below:
# PRECOMMIT_SKIP has always been scoped to the auto-fixing lint/typecheck
# stage (gate 3), not the review/policy gates, so it stays that way here.
#
# Gate 3 checks the WORKING TREE, which equals the index only for fully-staged
# files. So if a checked file is partially staged (staged AND has unstaged edits)
# the working tree no longer matches what's being committed — we can't validate
# it without guessing, and auto-fix would drag in the unstaged hunks. Rather than
# pass a commit it didn't actually inspect, gate 3 stops and asks you to stage
# the file fully or commit it on its own.
#
# Paths are read NUL-delimited into arrays and passed after `--`, so spaces,
# newlines, globs, and leading dashes in filenames are handled safely.
#
# Skip just the review gate (1):   CODEX_REVIEW_SKIP=1 git commit ...
# Skip just lint/typecheck (3):    PRECOMMIT_SKIP=1 git commit ...
# Skip all hooks:                  git commit --no-verify

set -uo pipefail

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

# --- gate 1: adversarial review -----------------------------------------------
"$root/.githooks/review.sh" || exit $?

# --- gate 2: staged-reference guard (local-tracker leak check) ---------------
# Rejects staged ADDITIONS that leak a reference to this repo's local,
# private issue tracker: a full "<repo>-<shorthand>" ID, a CLI invocation, or
# its name used in prose. This repo's own package/service names collide in
# shape with tracker IDs (e.g. "momentarily-worker"), so those known names
# are excluded below rather than flagged.
#
# The banned terms are assembled from character fragments at runtime, and
# this file's own path is excluded from the diff scanned below, so the guard
# can never flag itself.
# Repo name from the origin remote, not the checkout dir's basename: git
# worktrees (used for PR review / bb-managed checkouts) name their
# directories after a branch or PR, not the repo, which would otherwise
# make this guard target the wrong ID prefix.
_rg_repo=$(git remote get-url origin 2>/dev/null | sed -E 's#.*/##; s#\.git$##')
[ -z "$_rg_repo" ] && _rg_repo=$(basename "$root")
_rg_repo_re=$(printf '%s' "$_rg_repo" | sed -E 's/[.[\*^$+?(){}|\\]/\\&/g')
_rg_cli=$(printf '\142\144')
_rg_noun=$(printf '\142\145\141\144')
_rg_safe=(worker trainer viz collector held training station)

_rg_added=$(git diff --cached --no-color -U0 -- . ':!.githooks/pre-commit' 2>/dev/null \
  | grep -E '^\+' | grep -Ev '^\+\+\+ ')

_rg_hit=""
if [ -n "$_rg_added" ]; then
  _rg_hit=$(printf '%s\n' "$_rg_added" | grep -Eim1 "\\b${_rg_cli}[[:space:]]+[a-z][a-z-]*\\b|\\b${_rg_noun}s?\\b")
fi
if [ -z "$_rg_hit" ] && [ -n "$_rg_added" ]; then
  while IFS= read -r _rg_id; do
    [ -z "$_rg_id" ] && continue
    _rg_id_lc=$(printf '%s' "$_rg_id" | tr '[:upper:]' '[:lower:]')
    _rg_suffix=${_rg_id_lc#"${_rg_repo}-"}
    _rg_known=0
    for _rg_s in "${_rg_safe[@]}"; do
      [ "$_rg_suffix" = "$_rg_s" ] && _rg_known=1 && break
    done
    if [ "$_rg_known" -eq 0 ]; then
      _rg_hit=$(printf '%s\n' "$_rg_added" | grep -Fm1 -- "$_rg_id")
      break
    fi
  done < <(printf '%s\n' "$_rg_added" | grep -Eoi "\\b${_rg_repo_re}-[a-z0-9]+(\\.[a-z0-9]+)*\\b" | sort -u)
fi

if [ -n "$_rg_hit" ]; then
  echo "pre-commit: ✗ blocked — a staged addition looks like a reference to the" >&2
  echo "  local, private issue tracker. Policy: tracker IDs, CLI invocations, and" >&2
  echo "  tracker terminology must never enter a committed file." >&2
  echo "  offending line: ${_rg_hit#+}" >&2
  echo "  bypass once (if this is a false positive):  git commit --no-verify" >&2
  exit 1
fi
unset _rg_repo _rg_repo_re _rg_cli _rg_noun _rg_safe _rg_added _rg_hit _rg_id _rg_id_lc _rg_suffix _rg_known _rg_s

[ "${PRECOMMIT_SKIP:-}" = "1" ] && exit 0

staged=()
while IFS= read -r -d '' f; do staged+=("$f"); done \
  < <(git diff --cached --name-only -z --diff-filter=ACMR)
[ ${#staged[@]} -eq 0 ] && exit 0

unstaged=()
while IFS= read -r -d '' f; do unstaged+=("$f"); done < <(git diff --name-only -z)

is_unstaged() {
  local x=$1 u
  for u in ${unstaged[@]+"${unstaged[@]}"}; do [ "$u" = "$x" ] && return 0; done
  return 1
}
has_prefix() {
  local p=$1 f
  for f in "${staged[@]}"; do [[ $f == "$p"* ]] && return 0; done
  return 1
}

# Block partially-staged files in any checked stack (see header).
partial=()
for f in "${staged[@]}"; do
  is_unstaged "$f" || continue
  case "$f" in
    *.py | worker/* | trainer/* | viz/*) partial+=("$f") ;;
  esac
done
if [ ${#partial[@]} -gt 0 ]; then
  echo "pre-commit: ✗ partially-staged files can't be validated against this gate:" >&2
  for f in "${partial[@]}"; do echo "    $f" >&2; done
  echo "  stage them fully ('git add'), commit them separately, or PRECOMMIT_SKIP=1 to bypass once" >&2
  exit 1
fi

fail=0

# --- Python (root): ruff format + ruff check --fix, then pyright -------------
py=()
for f in "${staged[@]}"; do [[ $f == *.py ]] && py+=("$f"); done
if [ ${#py[@]} -gt 0 ]; then
  echo "pre-commit: python — ruff + pyright…" >&2
  uv run ruff format -- "${py[@]}" >/dev/null 2>&1
  uv run ruff check --fix -- "${py[@]}" >/dev/null 2>&1
  git add -- "${py[@]}"
  uv run ruff check -- "${py[@]}" || fail=1
  uv run pyright || fail=1
fi

# --- Worker / trainer (TS, bun): typecheck ----------------------------------
for pkg in worker trainer; do
  if has_prefix "$pkg/"; then
    echo "pre-commit: $pkg — typecheck…" >&2
    (
      cd "$pkg" || exit 1
      [ -f worker-configuration.d.ts ] || bun x wrangler types ./worker-configuration.d.ts >/dev/null 2>&1
      bun run typecheck
    ) || fail=1
  fi
done

# --- viz (TS, npm): typecheck + CSS parse ------------------------------------
# The CSS check is not redundant with typecheck: tsc never reads a stylesheet,
# so an unclosed block passes every other gate here and then 500s every route
# at request time.
if has_prefix "viz/"; then
  echo "pre-commit: viz — typecheck + css…" >&2
  ( cd viz && npm run --silent typecheck ) || fail=1
  ( cd viz && npm run --silent css-check ) || fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: ✗ blocked — fix the above (or PRECOMMIT_SKIP=1 to bypass once)" >&2
  exit 1
fi
exit 0

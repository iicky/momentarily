{
  "name": "momentarily-viz",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only dashboard for inspecting the Momentarily MTA feed + HMM model. Not part of the publish path.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "murk exec -- next dev",
    "dev:plain": "next dev",
    "build": "next build",
    "start": "murk exec -- next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "css-check": "node scripts/css-check.js",
    "check": "npm run typecheck && npm run css-check",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "start:e2e": "next start -p 39207"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@interrupted/murk-secrets": "^0.11.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "8.5.26",
    "typescript": "^5.6.0"
  }
}

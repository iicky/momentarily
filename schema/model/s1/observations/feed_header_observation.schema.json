{
  "$defs": {
    "RawLineage": {
      "additionalProperties": false,
      "description": "Decoded from a stored raw payload.",
      "properties": {
        "kind": {
          "const": "raw",
          "title": "Kind",
          "type": "string"
        },
        "payload_key": {
          "description": "The tick bundle or blob holding the bytes.",
          "title": "Payload Key",
          "type": "string"
        },
        "payload_member": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Bundle member; null for a blob.",
          "title": "Payload Member"
        },
        "payload_sha256": {
          "description": "Lowercase sha256 hex.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "payload_key",
        "payload_member",
        "payload_sha256"
      ],
      "title": "RawLineage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The FeedHeader of one GTFS-RT payload. Raw only.",
  "properties": {
    "fetch_id": {
      "title": "Fetch Id",
      "type": "string"
    },
    "gtfs_realtime_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Gtfs Realtime Version"
    },
    "header_timestamp": {
      "anyOf": [
        {
          "description": "UTC epoch seconds.",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Header Timestamp"
    },
    "incrementality": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Incrementality"
    },
    "lineage": {
      "$ref": "#/$defs/RawLineage"
    },
    "nyct_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Nyct Version"
    },
    "observed_at": {
      "description": "UTC epoch seconds.",
      "minimum": 0,
      "title": "Observed At",
      "type": "integer"
    },
    "source": {
      "enum": [
        "ace",
        "bdfm",
        "g",
        "jz",
        "nqrw",
        "l",
        "numbered",
        "si"
      ],
      "title": "Source",
      "type": "string"
    },
    "trip_replacement_periods": {
      "additionalProperties": {
        "anyOf": [
          {
            "description": "UTC epoch seconds.",
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "route_id -> end of the replacement window, as published.",
      "title": "Trip Replacement Periods",
      "type": "object"
    }
  },
  "required": [
    "lineage",
    "fetch_id",
    "source",
    "observed_at",
    "gtfs_realtime_version",
    "incrementality",
    "header_timestamp",
    "nyct_version",
    "trip_replacement_periods"
  ],
  "title": "FeedHeaderObservation",
  "type": "object"
}

    "Observation": {
      "description": "Continuous / instantaneous measurement of an entity.\n\nPeer to Alert. Empty in v1 of the publisher; populated when we wire upstream\nsources for travel-time (bridges/tunnels), headway, ETAs, tolls, occupancy.",
      "properties": {
        "entity_ref": {
          "title": "Entity Ref",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "observed_at": {
          "title": "Observed At",
          "type": "integer"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "entity_ref",
        "kind",
        "value",
        "unit",
        "observed_at",
        "source"
      ],
      "title": "Observation",
      "type": "object"
    },
    "ParamsProvenance": {
      "description": "Identity of the trained params.json behind this snapshot's inference \u2014 the\none thing code_sha can't say, since the model version moves independently of\nthe deployed Worker. trained_at is the trainer's own version stamp; key is the\nimmutable versioned R2 object it maps to (state/params/v<trained_at>.json), so\na consumer can pin the exact params without a LIST. Both null means the Worker\nis on BOOTSTRAP params (no params.json published yet), not that identity was\nunavailable.",
      "properties": {
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "trained_at": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trained At"
        }
      },
      "title": "ParamsProvenance",
      "type": "object"
    },
    "PlatformCrowding": {
      "description": "Estimated riders waiting on each platform: the platform's assumed share\nof its complex's usual entry rate for this hour, times how long it has been\nsince a train cleared it.\n\nThis is an ESTIMATE built on an admitted assumption (see `method`), not a\nmeasurement \u2014 nothing counts people on platforms. Keys are DIRECTIONAL GTFS\nstop ids ('127N'), so the parent station is the key with its N/S suffix\nstripped and its metadata is in the `stations` surface under that id.\n\nPlatforms that cannot be estimated are absent, not zeroed, and the reason\nis counted in `abstained`.",
      "properties": {
        "abstained": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Abstained",
          "type": "object"
        },
        "method": {
          "$ref": "#/$defs/PlatformCrowdingMethod"
        },
        "n_platforms": {
          "title": "N Platforms",
          "type": "integer"
        },
        "observed_at": {
          "title": "Observed At",
          "type": "integer"
        },
        "platforms": {
          "additionalProperties": {
            "$ref": "#/$defs/PlatformCrowdingEstimate"
          },
          "title": "Platforms",
          "type": "object"
        }
      },
      "required": [
        "observed_at",
        "method",
        "n_platforms"
      ],
      "title": "PlatformCrowding",
      "type": "object"
    },
    "PlatformCrowdingEstimate": {
      "description": "One platform's estimate. Carries the two inputs alongside the answer so a\nlive consumer can re-derive it against its own clock \u2014 the crowd grows at\n`entries_per_min` and `waiting_riders` is only correct as of `observed_at`,\nwhich by publish time is already minutes old.",
      "properties": {
        "entries_per_min": {
          "title": "Entries Per Min",
          "type": "number"
        },
        "last_train_at": {
          "title": "Last Train At",
          "type": "integer"
        },
        "waiting_riders": {
          "title": "Waiting Riders",
          "type": "integer"
        }
      },
      "required": [
        "last_train_at",
        "entries_per_min",
        "waiting_riders"
      ],
      "title": "PlatformCrowdingEstimate",
      "type": "object"
    },
    "PlatformCrowdingMethod": {
      "description": "The constants and admitted assumptions behind every estimate in this\nsurface. Published rather than documented so a consumer can reproduce the\narithmetic and see what it does not know.",
      "properties": {
        "baseline_generated_at": {
          "title": "Baseline Generated At",
          "type": "integer"
        },
        "baseline_window_end": {
          "title": "Baseline Window End",
          "type": "string"
        },
        "baseline_window_start": {
          "title": "Baseline Window Start",
          "type": "string"
        },
        "excludes": {
          "items": {
            "type": "string"
          },
          "title": "Excludes",
          "type": "array"
        },
        "formula": {
          "default": "entries_per_min * minutes_since_last_train",
          "title": "Formula",
          "type": "string"
        },
        "max_gap_minutes": {
          "title": "Max Gap Minutes",
          "type": "integer"
        },
        "served_window_minutes": {
          "title": "Served Window Minutes",
          "type": "integer"
        },
        "service_weight_feed_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Weight Feed Version"
        },
        "service_weight_generated_at": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Weight Generated At"
        },
        "split_basis": {
          "default": "uniform_over_served_platforms",
          "enum": [
            "uniform_over_served_platforms",
            "scheduled_service_over_served_platforms"
          ],
          "title": "Split Basis",
          "type": "string"
        }
      },
      "required": [
        "max_gap_minutes",
        "served_window_minutes",
        "baseline_generated_at",
        "baseline_window_start",
        "baseline_window_end"
      ],
      "title": "PlatformCrowdingMethod",
      "type": "object"
